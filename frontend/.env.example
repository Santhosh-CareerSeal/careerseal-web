# Frontend environment variables — copy to ".env" and fill in real values.
# Only VITE_-prefixed vars are exposed to the browser. Put NO secrets here.

# Backend API base URL (local dev default shown; set to your Render URL in prod)
VITE_API_URL=http://localhost:5000

# Google OAuth client id (public — safe to expose)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
