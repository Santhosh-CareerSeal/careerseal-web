# Backend environment variables — copy to ".env" and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (Supabase Postgres — from Supabase → Connect → ORMs → Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth
JWT_SECRET=your-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Encryption (for Aadhaar/passport/contact at rest) — 64 hex chars (32 bytes)
ENCRYPTION_KEY=your-32-byte-hex-key

# Supabase Storage (service key — keep secret, server-side only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-or-secret-key

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# AI (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
